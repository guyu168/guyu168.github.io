.github-project-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin: 22px 0 28px;
  text-align: left;
}

.github-project-card {
  display: flex;
  flex-direction: column;
  min-height: 250px;
  padding: 22px;
  border: 1px solid #dfe5ec;
  border-radius: 14px;
  background: linear-gradient(145deg, #ffffff 0%, #f7f9fc 100%);
  box-shadow: 0 10px 28px rgba(31, 45, 61, 0.08);
}

.github-project-title {
  margin: 8px 0 10px;
  color: #172033;
  font-size: 1.08em;
  font-weight: 700;
  line-height: 1.35;
}

.github-project-card p {
  flex: 1;
  margin: 0;
  color: #485568;
  font-size: 0.94em;
  line-height: 1.68;
}

.github-project-kicker {
  color: #1769aa;
  font-size: 0.72em;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.github-project-links {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 18px;
}

.github-project-links a {
  border-bottom: 0;
  color: #1769aa;
  font-size: 0.86em;
  font-weight: 600;
  text-decoration: none;
}

.github-project-links a:hover {
  color: #0d4775;
}

@media (max-width: 767px) {
  .github-project-grid {
    grid-template-columns: 1fr;
  }

  .github-project-card {
    min-height: 0;
  }
}
